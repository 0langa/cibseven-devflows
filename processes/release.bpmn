<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="devflows_definitions"
                  targetNamespace="http://cibseven.org/devflows"
                  exporter="Camunda Modeler"
                  exporterVersion="5.49.0">

  <bpmn:error id="error_publish_failed" name="Publish failed" errorCode="PUBLISH_FAILED" />

  <bpmn:process id="devflows-release" name="Release ritual" isExecutable="true"
                camunda:historyTimeToLive="P30D">

    <bpmn:startEvent id="start" name="Release requested">
      <bpmn:outgoing>flow_start_gates</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="run_gates" name="Run gates"
                      camunda:type="external" camunda:topic="devflows.gates">
      <bpmn:incoming>flow_start_gates</bpmn:incoming>
      <bpmn:outgoing>flow_gates_gateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="gates_gateway" name="Gates passed?">
      <bpmn:incoming>flow_gates_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_gates_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_gates_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="draft_notes" name="Draft release notes"
                      camunda:type="external" camunda:topic="devflows.notes">
      <bpmn:incoming>flow_gates_yes</bpmn:incoming>
      <bpmn:outgoing>flow_notes_policy</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:businessRuleTask id="decide_policy" name="Decide policy"
                           camunda:decisionRef="release-policy"
                           camunda:decisionRefBinding="latest"
                           camunda:resultVariable="policy"
                           camunda:mapDecisionResult="singleResult">
      <bpmn:incoming>flow_notes_policy</bpmn:incoming>
      <bpmn:outgoing>flow_policy_gateway</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="policy_gateway" name="Approval required?">
      <bpmn:incoming>flow_policy_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_needs_approval</bpmn:outgoing>
      <bpmn:outgoing>flow_auto_approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="approve_release" name="Approve release"
                   camunda:candidateGroups="camunda-admin">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="approved" label="Approve this release" type="boolean"
                             defaultValue="false" />
          <camunda:formField id="release_notes" label="Release notes" type="string"
                             defaultValue="${release_notes}" />
          <camunda:formField id="approval_comment" label="Comment" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_needs_approval</bpmn:incoming>
      <bpmn:outgoing>flow_approval_gateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="approval_timer" name="Timed out"
                        attachedToRef="approve_release" cancelActivity="true">
      <bpmn:outgoing>flow_timer_end</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${approval_timeout}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:exclusiveGateway id="approval_gateway" name="Approved?">
      <bpmn:incoming>flow_approval_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_approved_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_approved_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="create_tag" name="Tag"
                      camunda:type="external" camunda:topic="devflows.tag">
      <bpmn:incoming>flow_approved_yes</bpmn:incoming>
      <bpmn:incoming>flow_auto_approved</bpmn:incoming>
      <bpmn:outgoing>flow_tag_publish</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:boundaryEvent id="compensate_tag" name="Undo" attachedToRef="create_tag">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="undo_tag" name="Delete the tag" isForCompensation="true"
                      camunda:type="external" camunda:topic="devflows.untag" />

    <bpmn:serviceTask id="publish_release" name="Publish"
                      camunda:type="external" camunda:topic="devflows.publish">
      <bpmn:incoming>flow_tag_publish</bpmn:incoming>
      <bpmn:outgoing>flow_publish_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:boundaryEvent id="publish_failed" name="Publish failed"
                        attachedToRef="publish_release">
      <bpmn:outgoing>flow_publish_failed</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="error_publish_failed" />
    </bpmn:boundaryEvent>

    <bpmn:intermediateThrowEvent id="throw_compensation" name="Undo the tag">
      <bpmn:incoming>flow_publish_failed</bpmn:incoming>
      <bpmn:outgoing>flow_compensation_end</bpmn:outgoing>
      <bpmn:compensateEventDefinition />
    </bpmn:intermediateThrowEvent>

    <bpmn:endEvent id="end_gates_failed" name="Gates failed">
      <bpmn:incoming>flow_gates_no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_approval_expired" name="Approval expired">
      <bpmn:incoming>flow_timer_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_rejected" name="Release rejected">
      <bpmn:incoming>flow_approved_no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_publish_failed" name="Publish failed">
      <bpmn:incoming>flow_compensation_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_released" name="Released">
      <bpmn:incoming>flow_publish_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="flow_start_gates" sourceRef="start" targetRef="run_gates" />
    <bpmn:sequenceFlow id="flow_gates_gateway" sourceRef="run_gates" targetRef="gates_gateway" />
    <bpmn:sequenceFlow id="flow_gates_yes" name="yes" sourceRef="gates_gateway"
                       targetRef="draft_notes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${gates_passed == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gates_no" name="no" sourceRef="gates_gateway"
                       targetRef="end_gates_failed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${gates_passed == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_notes_policy" sourceRef="draft_notes" targetRef="decide_policy" />
    <bpmn:sequenceFlow id="flow_policy_gateway" sourceRef="decide_policy"
                       targetRef="policy_gateway" />
    <bpmn:sequenceFlow id="flow_needs_approval" name="ask a human" sourceRef="policy_gateway"
                       targetRef="approve_release">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${policy.approval_required == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_auto_approved" name="policy says ship" sourceRef="policy_gateway"
                       targetRef="create_tag">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${policy.approval_required == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_timer_end" sourceRef="approval_timer"
                       targetRef="end_approval_expired" />
    <bpmn:sequenceFlow id="flow_approval_gateway" sourceRef="approve_release"
                       targetRef="approval_gateway" />
    <bpmn:sequenceFlow id="flow_approved_yes" name="ship" sourceRef="approval_gateway"
                       targetRef="create_tag">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_approved_no" name="stop" sourceRef="approval_gateway"
                       targetRef="end_rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_tag_publish" sourceRef="create_tag" targetRef="publish_release" />
    <bpmn:sequenceFlow id="flow_publish_failed" sourceRef="publish_failed"
                       targetRef="throw_compensation" />
    <bpmn:sequenceFlow id="flow_compensation_end" sourceRef="throw_compensation"
                       targetRef="end_publish_failed" />
    <bpmn:sequenceFlow id="flow_publish_end" sourceRef="publish_release"
                       targetRef="end_released" />

    <!-- Artifacts come after every flow element; the BPMN schema requires it. -->
    <bpmn:association id="assoc_compensate_tag" associationDirection="One"
                      sourceRef="compensate_tag" targetRef="undo_tag" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="devflows-release">
      <bpmndi:BPMNShape id="di_start" bpmnElement="start">
        <dc:Bounds x="150" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="127" y="225" width="83" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_run_gates" bpmnElement="run_gates">
        <dc:Bounds x="240" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_gates_gateway" bpmnElement="gates_gateway" isMarkerVisible="true">
        <dc:Bounds x="395" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="382" y="132" width="76" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_end_gates_failed" bpmnElement="end_gates_failed">
        <dc:Bounds x="402" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="386" y="365" width="69" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_draft_notes" bpmnElement="draft_notes">
        <dc:Bounds x="500" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_decide_policy" bpmnElement="decide_policy">
        <dc:Bounds x="650" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_policy_gateway" bpmnElement="policy_gateway" isMarkerVisible="true">
        <dc:Bounds x="805" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="789" y="132" width="83" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_approve_release" bpmnElement="approve_release">
        <dc:Bounds x="910" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_approval_timer" bpmnElement="approval_timer">
        <dc:Bounds x="942" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="985" y="233" width="52" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_end_approval_expired" bpmnElement="end_approval_expired">
        <dc:Bounds x="942" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="918" y="365" width="85" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_approval_gateway" bpmnElement="approval_gateway"
                        isMarkerVisible="true">
        <dc:Bounds x="1065" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1062" y="132" width="57" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_end_rejected" bpmnElement="end_rejected">
        <dc:Bounds x="1072" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1050" y="365" width="81" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_create_tag" bpmnElement="create_tag">
        <dc:Bounds x="1170" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_compensate_tag" bpmnElement="compensate_tag">
        <dc:Bounds x="1202" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1245" y="233" width="30" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_undo_tag" bpmnElement="undo_tag">
        <dc:Bounds x="1170" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_publish_release" bpmnElement="publish_release">
        <dc:Bounds x="1330" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_publish_failed" bpmnElement="publish_failed">
        <dc:Bounds x="1362" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1405" y="233" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_throw_compensation" bpmnElement="throw_compensation">
        <dc:Bounds x="1362" y="452" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1345" y="495" width="71" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_end_publish_failed" bpmnElement="end_publish_failed">
        <dc:Bounds x="1482" y="452" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1462" y="495" width="77" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_end_released" bpmnElement="end_released">
        <dc:Bounds x="1502" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1497" y="225" width="47" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="di_flow_start_gates" bpmnElement="flow_start_gates">
        <di:waypoint x="186" y="200" /><di:waypoint x="240" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_flow_gates_gateway" bpmnElement="flow_gates_gateway">
        <di:waypoint x="340" y="200" /><di:waypoint x="395" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_flow_gates_yes" bpmnElement="flow_gates_yes">
        <di:waypoint x="445" y="200" /><di:waypoint x="500" y="200" />
        <bpmndi:BPMNLabel><dc:Bounds x="462" y="182" width="18" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_flow_gates_no" bpmnElement="flow_gates_no">
        <di:waypoint x="420" y="225" /><di:waypoint x="420" y="322" />
        <bpmndi:BPMNLabel><dc:Bounds x="427" y="262" width="14" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_flow_notes_policy" bpmnElement="flow_notes_policy">
        <di:waypoint x="600" y="200" /><di:waypoint x="650" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_flow_policy_gateway" bpmnElement="flow_policy_gateway">
        <di:waypoint x="750" y="200" /><di:waypoint x="805" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_flow_needs_approval" bpmnElement="flow_needs_approval">
        <di:waypoint x="855" y="200" /><di:waypoint x="910" y="200" />
        <bpmndi:BPMNLabel><dc:Bounds x="850" y="182" width="65" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_flow_auto_approved" bpmnElement="flow_auto_approved">
        <di:waypoint x="830" y="175" /><di:waypoint x="830" y="90" />
        <di:waypoint x="1220" y="90" /><di:waypoint x="1220" y="160" />
        <bpmndi:BPMNLabel><dc:Bounds x="975" y="72" width="90" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_flow_timer_end" bpmnElement="flow_timer_end">
        <di:waypoint x="960" y="258" /><di:waypoint x="960" y="322" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_flow_approval_gateway" bpmnElement="flow_approval_gateway">
        <di:waypoint x="1010" y="200" /><di:waypoint x="1065" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_flow_approved_yes" bpmnElement="flow_approved_yes">
        <di:waypoint x="1115" y="200" /><di:waypoint x="1170" y="200" />
        <bpmndi:BPMNLabel><dc:Bounds x="1131" y="182" width="23" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_flow_approved_no" bpmnElement="flow_approved_no">
        <di:waypoint x="1090" y="225" /><di:waypoint x="1090" y="322" />
        <bpmndi:BPMNLabel><dc:Bounds x="1097" y="262" width="23" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_flow_tag_publish" bpmnElement="flow_tag_publish">
        <di:waypoint x="1270" y="200" /><di:waypoint x="1330" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_flow_publish_failed" bpmnElement="flow_publish_failed">
        <di:waypoint x="1380" y="258" /><di:waypoint x="1380" y="452" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_flow_compensation_end" bpmnElement="flow_compensation_end">
        <di:waypoint x="1398" y="470" /><di:waypoint x="1482" y="470" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_flow_publish_end" bpmnElement="flow_publish_end">
        <di:waypoint x="1430" y="200" /><di:waypoint x="1502" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_assoc_compensate_tag" bpmnElement="assoc_compensate_tag">
        <di:waypoint x="1220" y="258" /><di:waypoint x="1220" y="330" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
